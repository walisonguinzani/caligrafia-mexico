# Zenith Payments API (solo backend: configúralas en Vercel → Settings → Environment Variables)
ZENITH_PUBLIC_KEY=
ZENITH_SECRET_KEY=
ZENITH_WEBHOOK_SECRET=
ZENITH_ENVIRONMENT=production

# Base de datos para pedidos e idempotencia (Vercel KV / Upstash Redis)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# URL pública del sitio (para returnUrl y cancelUrl). Ej: https://tudominio.com
SITE_URL=

# Accesos que se muestran SOLO cuando el webhook confirma el pago
ACCESS_URL=
VIP_GROUP_URL=

# Opcional: tu automatización (ZapData, Make…) recibe cada pedido pagado
FULFILLMENT_WEBHOOK_URL=
